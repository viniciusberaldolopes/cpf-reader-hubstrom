# Chave pública da aplicação Web cadastrada no Firebase
VITE_FIREBASE_API_KEY=

# Domínio de autenticação exibido no objeto firebaseConfig
VITE_FIREBASE_AUTH_DOMAIN=

# URL da instância do Firebase Realtime Database
VITE_FIREBASE_DATABASE_URL=

# Identificador do projeto Firebase
VITE_FIREBASE_PROJECT_ID=

# Nome do bucket do Firebase Storage
VITE_FIREBASE_STORAGE_BUCKET=

# Identificador do remetente do Firebase Cloud Messaging
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Identificador da aplicação Web cadastrada no Firebase
VITE_FIREBASE_APP_ID=
