# Chave pública da aplicação Web cadastrada no Firebase
VITE_FIREBASE_API_KEY=

# Domínio de autenticação exibido no objeto firebaseConfig
VITE_FIREBASE_AUTH_DOMAIN=

# URL da instância do Firebase Realtime Database
VITE_FIREBASE_DATABASE_URL=

# Identificador do projeto Firebase
VITE_FIREBASE_PROJECT_ID=

# Identificador da aplicação Web cadastrada no Firebase
VITE_FIREBASE_APP_ID=

# URL exibida em Project Settings > API no painel do Supabase
VITE_SUPABASE_URL=

# Chave pública/publishable key exibida em Project Settings > API
# Nunca coloque a secret key ou service_role key no frontend.
VITE_SUPABASE_PUBLISHABLE_KEY=
